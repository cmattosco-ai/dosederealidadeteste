# Copie para .streamlit/secrets.toml (local) ou cole no painel do Streamlit Cloud:
# App > Settings > Secrets. NUNCA envie o secrets.toml real para o GitHub.

ANTHROPIC_API_KEY = "sk-ant-..."          # console.anthropic.com > API Keys
MP_ACCESS_TOKEN = "APP_USR-..."           # Mercado Pago > Suas integrações > Credenciais de produção
PRECO = "19.90"                           # preço em reais
APP_URL = "https://seu-app.streamlit.app" # endereço público do app (para voltar do pagamento)
CONTATO_SUPORTE = "contato@seudominio.com"
MAX_GERACOES = "3"                        # prévias por sessão/pedido (controla custo de IA)
MODO_TESTE = "false"                      # "true" mostra botão de pagamento simulado. Nunca em produção.
